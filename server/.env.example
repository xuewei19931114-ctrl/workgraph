HOST=127.0.0.1
PORT=8787
# Proxy origin only. The client appends /openai/v1/responses.
GPT56_BASE_URL=https://example-proxy.invalid
GPT56_API_KEY=replace-with-your-api-key
GPT56_MODEL=openai.gpt-5.6-sol
GPT56_REASONING_EFFORT=high
GPT56_TIMEOUT_MS=120000
PROFILE_CONTEXT_TOKEN_LIMIT=400000
PROFILE_EXTRACTOR_CONCURRENCY=3
PROFILE_ENABLE_CRITIC=false
WORKGRAPH_DB_PATH=server/data/workgraph.db
TRANSCRIPT_RETENTION_DAYS=7
