{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "server/src",
    "outDir": "server/dist",
    "tsBuildInfoFile": "server/dist/tsconfig.server.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.shared.json" }],
  "include": ["server/src"]
}
